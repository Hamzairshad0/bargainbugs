{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "buildCommand": "npm run build",
    "outputDirectory": "public",
    "regions": ["fra1"],
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.8.0",
            "maxDuration": 60,
            "memory": 1024,
            "excludeFiles": "{node_modules/**,tests/**,.git/**,public/samples/**}"
        }
    },
    "routes": [
        { "src": "/build/(.*)", "dest": "/build/$1", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
        { "src": "/images/(.*)", "dest": "/images/$1", "headers": { "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800" } },
        { "src": "/(favicon\\.ico|favicon\\.svg|robots\\.txt)", "dest": "/$1", "headers": { "Cache-Control": "public, max-age=86400" } },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ],
    "crons": [
        { "path": "/cron/ebay-sync", "schedule": "0 6 * * *" }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_CONFIG_CACHE": "/tmp/config.php",
        "APP_EVENTS_CACHE": "/tmp/events.php",
        "APP_PACKAGES_CACHE": "/tmp/packages.php",
        "APP_ROUTES_CACHE": "/tmp/routes.php",
        "APP_SERVICES_CACHE": "/tmp/services.php",
        "VIEW_COMPILED_PATH": "/tmp",
        "LOG_CHANNEL": "stderr",
        "SESSION_DRIVER": "cookie",
        "CACHE_STORE": "file",
        "CACHE_FILE_PATH": "/tmp/cache",
        "QUEUE_CONNECTION": "sync"
    }
}
